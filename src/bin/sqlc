#!/usr/bin/env bash

DIRNAME=$0

if [ "${DIRNAME:0:1}" = "/" ]; then
  CURDIR=$(dirname "$DIRNAME")
else
  CURDIR="$(pwd)"/"$(dirname "$DIRNAME")"
fi

APP="$CURDIR"/lib/${artifactId}-${version}.jar

if [ -n "$SQLC_JAVA_HOME" ]; then
  "$SQLC_JAVA_HOME"/bin/java -jar $APP "$@"
else
  java -jar $APP "$@"
fi
